Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LiDAR Points1
        - /Local Map1
        - /Odometry1
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 85; 255; 127
      Color Transformer: FlatColor
      Enabled: true
      Name: LiDAR Points
      Size (Pixels): 3
      Style: Flat Squares
      Topic: /velodyne_points
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 0
      Color Transformer: FlatColor
      Enabled: true
      Name: Local Map
      Size (Pixels): 2
      Style: Flat Squares
      Topic: /rko_lio/local_map
      Value: true
    - Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1000
      Name: Odometry
      Shape:
        Alpha: 1
        Axes Length: 1
        Color: 255; 25; 0
        Value: Arrow
      Topic: /rko_lio/odometry
      Value: true
  Enabled: true
  Fixed Frame: odom
  Frame Rate: 30
