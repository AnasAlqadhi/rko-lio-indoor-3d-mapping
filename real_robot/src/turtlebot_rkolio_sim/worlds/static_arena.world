<?xml version="1.0"?>
<sdf version="1.6">
  <world name="static_arena">
    <!-- Same arena layout as tubitak phase3_arena: 10x10m with static obstacles -->

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>25</update_rate>
    </plugin>

    <scene>
      <shadows>0</shadows>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -12 20 0 1.0 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════ Outer walls (10x10m arena) ══════════════ -->
    <model name="wN">
      <static>true</static>
      <pose>0 5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>10.3 0.15 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10.3 0.15 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wS">
      <static>true</static>
      <pose>0 -5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>10.3 0.15 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10.3 0.15 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wE">
      <static>true</static>
      <pose>5 0 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.15 10 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 10 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wW">
      <static>true</static>
      <pose>-5 0 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.15 10 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 10 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════ Diagonal divider walls (upper half) ══════════════ -->
    <model name="dU_L">
      <static>true</static>
      <pose>-3.9 2.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2.2 0.12 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.2 0.12 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dU_R">
      <static>true</static>
      <pose>3.9 2.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2.2 0.12 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.2 0.12 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dU_CL">
      <static>true</static>
      <pose>-1.5 2.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.5 0.12 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 0.12 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dU_CR">
      <static>true</static>
      <pose>1.5 2.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.5 0.12 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 0.12 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════ Diagonal divider walls (lower half) ══════════════ -->
    <model name="dD_L">
      <static>true</static>
      <pose>-3.9 -2.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2.2 0.12 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.2 0.12 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dD_R">
      <static>true</static>
      <pose>3.9 -2.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2.2 0.12 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.2 0.12 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dD_CL">
      <static>true</static>
      <pose>-1.5 -2.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.5 0.12 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 0.12 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dD_CR">
      <static>true</static>
      <pose>1.5 -2.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.5 0.12 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 0.12 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════ Inner corridor walls ══════════════ -->
    <model name="iU_L">
      <static>true</static>
      <pose>-2.8 3.75 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.12 2.5 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.12 2.5 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="iU_R">
      <static>true</static>
      <pose>2.8 3.75 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.12 2.5 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.12 2.5 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="iD_L">
      <static>true</static>
      <pose>-2.8 -3.75 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.12 2.5 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.12 2.5 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="iD_R">
      <static>true</static>
      <pose>2.8 -3.75 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.12 2.5 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.12 2.5 0.8</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════ Vertical obstacle pillars (corners) ══════════════ -->
    <model name="vNL">
      <static>true</static>
      <pose>-3.5 3.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="vNR">
      <static>true</static>
      <pose>3.5 3.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="vSL">
      <static>true</static>
      <pose>-3.5 -3.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="vSR">
      <static>true</static>
      <pose>3.5 -3.5 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.4 0.2 0.2 1</ambient><diffuse>0.5 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════ Scattered box obstacles ══════════════ -->
    <model name="stA">
      <static>true</static>
      <pose>-1.8 1.2 0.25 0 0 0.3</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.6 0.3 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.3 0.5</size></box></geometry>
          <material><ambient>0.3 0.4 0.5 1</ambient><diffuse>0.35 0.45 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stB">
      <static>true</static>
      <pose>2.0 -1.5 0.25 0 0 -0.4</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.5 0.4 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.4 0.5</size></box></geometry>
          <material><ambient>0.3 0.4 0.5 1</ambient><diffuse>0.35 0.45 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stC">
      <static>true</static>
      <pose>0.5 3.8 0.25 0 0 0.7</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.7 0.3 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.7 0.3 0.5</size></box></geometry>
