        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.3 0.4 0.5 1</ambient><diffuse>0.35 0.45 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════ Centre-zone cylindrical obstacles ══════════════ -->
    <model name="s1">
      <static>true</static>
      <pose>-3.5 0 0.4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry>
