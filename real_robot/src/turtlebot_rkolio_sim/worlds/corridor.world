<?xml version="1.0"?>
<sdf version="1.6">
  <world name="corridor_world">

    <!-- ── Physics ─────────────────────────────────────────────────────── -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Sun directional light ───────────────────────────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── 6 overhead point lights evenly spaced around the loop ───────── -->
    <light name="light_1" type="point">
      <pose>7.0 0 2.8 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="light_2" type="point">
      <pose>-7.0 0 2.8 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="light_3" type="point">
      <pose>0 4.0 2.8 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="light_4" type="point">
      <pose>0 -4.0 2.8 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="light_5" type="point">
      <pose>5.0 4.0 2.8 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="light_6" type="point">
      <pose>-5.0 -4.0 2.8 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- ── Ground plane ────────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════════
         Closed rectangular loop corridor
         Outer rectangle: 18m x 12m
         Corridor width: 2.0m
         Wall height: 3.0m, thickness: 0.25m

         Outer walls form a rectangle from (-9,-6) to (9,6)
         Inner walls form a rectangle from (-7,-4) to (7,4)
         Robot starts at (0,0) which is inside the corridor loop.
         ══════════════════════════════════════════════════════════════════ -->
    <model name="corridor">
      <static>true</static>

      <!-- ── Outer walls ─────────────────────────────────────────────── -->
      <!-- Outer North wall: y = +6, from x=-9 to x=9 -->
      <link name="outer_north">
        <pose>0 6.0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>18.0 0.25 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>18.0 0.25 3.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Outer South wall: y = -6 -->
      <link name="outer_south">
        <pose>0 -6.0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>18.0 0.25 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>18.0 0.25 3.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Outer East wall: x = +9, from y=-6 to y=6 -->
      <link name="outer_east">
        <pose>9.0 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.25 12.0 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.25 12.0 3.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Outer West wall: x = -9 -->
      <link name="outer_west">
        <pose>-9.0 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.25 12.0 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.25 12.0 3.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- ── Inner walls ─────────────────────────────────────────────── -->
      <!-- Inner North wall: y = +4, from x=-7 to x=7 -->
      <link name="inner_north">
        <pose>0 4.0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>14.0 0.25 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>14.0 0.25 3.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Inner South wall: y = -4 -->
      <link name="inner_south">
        <pose>0 -4.0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>14.0 0.25 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>14.0 0.25 3.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Inner East wall: x = +7 -->
      <link name="inner_east">
        <pose>7.0 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.25 8.0 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.25 8.0 3.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Inner West wall: x = -7 -->
      <link name="inner_west">
        <pose>-7.0 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.25 8.0 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.25 8.0 3.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

  </world>
</sdf>
