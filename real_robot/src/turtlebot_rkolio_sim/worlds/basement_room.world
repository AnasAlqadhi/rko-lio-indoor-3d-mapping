<?xml version="1.0"?>
<sdf version="1.6">
  <world name="basement_room_world">

    <!-- ── Physics ─────────────────────────────────────────────────────── -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Sun directional light ───────────────────────────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── 4 ceiling lights ────────────────────────────────────────────── -->
    <light name="ceiling_light_1" type="point">
      <pose>-2.0 -1.5 2.8 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.3</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <light name="ceiling_light_2" type="point">
      <pose>2.0 -1.5 2.8 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.3</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <light name="ceiling_light_3" type="point">
      <pose>-2.0 1.5 2.8 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.3</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <light name="ceiling_light_4" type="point">
      <pose>2.0 1.5 2.8 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.3</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <!-- ── Floor ───────────────────────────────────────────────────────── -->
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="col">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 10</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════════
         Room: 8.0m x 6.0m, walls 3.0m tall, 0.2m thick
         Room center at origin, extends from (-4,-3) to (4,3)
         Doorway: 1.0m wide gap in south wall at center
         ══════════════════════════════════════════════════════════════════ -->
    <model name="room">
      <static>true</static>

      <!-- North wall: y = +3 -->
      <link name="wall_north">
        <pose>0 3.0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>8.0 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>8.0 0.2 3.0</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.85 0.85 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South wall LEFT of doorway: x from -4 to -0.5 (3.5m wide) -->
      <link name="wall_south_left">
        <pose>-2.25 -3.0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>3.5 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>3.5 0.2 3.0</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.85 0.85 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South wall RIGHT of doorway: x from +0.5 to +4 (3.5m wide) -->
      <link name="wall_south_right">
        <pose>2.25 -3.0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>3.5 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>3.5 0.2 3.0</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.85 0.85 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- East wall: x = +4 -->
      <link name="wall_east">
        <pose>4.0 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.2 6.0 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 6.0 3.0</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.85 0.85 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- West wall: x = -4 -->
      <link name="wall_west">
        <pose>-4.0 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.2 6.0 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 6.0 3.0</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.85 0.85 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- ── 4 ceiling light fixture visuals ────────────────────────── -->
      <link name="light_fixture_1">
        <pose>-2.0 -1.5 2.9 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>0.6 0.2 0.05</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <emissive>0.8 0.8 0.8 1</emissive>
          </material>
        </visual>
      </link>

      <link name="light_fixture_2">
        <pose>2.0 -1.5 2.9 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>0.6 0.2 0.05</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <emissive>0.8 0.8 0.8 1</emissive>
          </material>
        </visual>
      </link>

      <link name="light_fixture_3">
        <pose>-2.0 1.5 2.9 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>0.6 0.2 0.05</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <emissive>0.8 0.8 0.8 1</emissive>
          </material>
        </visual>
      </link>

      <link name="light_fixture_4">
        <pose>2.0 1.5 2.9 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>0.6 0.2 0.05</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <emissive>0.8 0.8 0.8 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Furniture obstacles ─────────────────────────────────────────── -->

    <!-- Box A: table 1.0x0.5x0.8m, brown -->
    <model name="box_a">
      <static>true</static>
      <pose>-2.5 -1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.0 0.5 0.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.0 0.5 0.8</size></box></geometry>
          <material>
            <ambient>0.45 0.25 0.1 1</ambient>
            <diffuse>0.45 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box B: cabinet 0.8x0.8x0.75m, brown -->
    <model name="box_b">
      <static>true</static>
      <pose>2.5 -1.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.8 0.8 0.75</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.8 0.75</size></box></geometry>
          <material>
            <ambient>0.4 0.22 0.1 1</ambient>
            <diffuse>0.4 0.22 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box C: shelf 1.2x0.4x0.7m, dark gray -->
    <model name="box_c">
      <static>true</static>
      <pose>-2.5 1.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.2 0.4 0.7</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.2 0.4 0.7</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box D: storage 0.6x0.6x0.9m, brown -->
    <model name="box_d">
      <static>true</static>
      <pose>2.5 1.8 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.6 0.9</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.6 0.9</size></box></geometry>
          <material>
            <ambient>0.45 0.25 0.1 1</ambient>
            <diffuse>0.45 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cylindrical pillar at center -->
    <model name="pillar">
      <static>true</static>
      <pose>0 0 1.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.15</radius><length>2.8</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>2.8</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
