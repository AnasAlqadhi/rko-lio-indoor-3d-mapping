Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1.0

    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR Raw
      Enabled: true
      Topic:
        Value: /velodyne_points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Alpha: 0.5
      Decay Time: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: Fixer Output (proc)
      Enabled: true
      Topic:
        Value: /velodyne_points_proc
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 100; 255
      Alpha: 0.5
      Decay Time: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: FAST-LIO Current Scan
      Enabled: true
      Topic:
        Value: /cloud_registered
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Alpha: 0.7
      Decay Time: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: FAST-LIO Global Map
      Enabled: true
      Topic:
        Value: /Laser_map
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 3
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Alpha: 1.0
      Decay Time: 0

    - Class: rviz_default_plugins/Path
      Name: FAST-LIO Path
      Enabled: true
      Topic:
        Value: /path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Color: 255; 100; 0
      Line Width: 0.05

    - Class: rviz_default_plugins/Odometry
      Name: FAST-LIO Odometry
      Enabled: true
      Topic:
        Value: /Odometry
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Color: 255; 25; 0
      Shape:
        Value: Arrow
        Shaft Length: 0.15
        Shaft Radius: 0.02
        Head Length: 0.05
        Head Radius: 0.03
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 200
      Covariance:
        Value: false

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Show Arrows: false
      Show Axes: true
      Marker Scale: 0.3
      Frame Timeout: 15

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 10.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: base_footprint
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 100
  Y: 100
